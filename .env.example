# ===========================================================================
#  Empório Padox — variáveis de ambiente
#  Copie para .env.local e preencha. .env.local NÃO vai para o git.
# ===========================================================================

# --- Supabase -------------------------------------------------------------
# Project Settings → API, no painel do Supabase (projeto: wine-ecommerce)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço — SÓ no servidor. Nunca prefixe com NEXT_PUBLIC_.
# Usada no checkout (criar pedido) e no webhook do Mercado Pago.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------
# Sem barra no fim. Usada nas back_urls e no notification_url do Mercado
# Pago — em produção, a URL pública real (ex. https://emporio-padox.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mercado Pago ---------------------------------------------------------
# Credenciais de produção → Seu negócio → Configurações → Credenciais
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=

# Painel da aplicação → Webhooks → configurar a URL abaixo e copiar a
# "Assinatura secreta" gerada. Sem isso, o webhook ainda funciona (o
# pagamento é sempre reconferido na API da MP), só fica sem essa camada
# extra de verificação.
#   URL do webhook: {NEXT_PUBLIC_SITE_URL}/api/webhooks/mercadopago
#   Eventos: Pagamentos
MERCADOPAGO_WEBHOOK_SECRET=
